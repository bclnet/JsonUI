{
  "_ui": {
    "version": 1,
    "state": { "email": "", "password": "", "remember": false, "status": "" },
    "script": "function isValidEmail(v) { return /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(v); }\nfunction canSubmit() { return isValidEmail(state.email) && state.password.length >= 8; }\nfunction submit() { state.status = 'Signing in as ' + state.email; host.invoke('login', { email: state.email, remember: state.remember }); }"
  },
  "type": "NavigationView",
  "title": "Sign in",
  "content": {
    "type": "Form",
    "content": [
      {
        "type": "Section",
        "header": "Account",
        "content": [
          { "type": "TextField", "id": "email", "title": "Email", "text": "$email", "keyboard": "email", "autocapitalization": "none",
            "error": "${state.email.length > 0 && !isValidEmail(state.email) ? 'Enter a valid email address' : ''}" },
          { "type": "SecureField", "id": "password", "title": "Password", "text": "$password",
            "error": "${state.password.length > 0 && state.password.length < 8 ? 'At least 8 characters' : ''}" },
          { "type": "Toggle", "label": "Remember me", "isOn": "$remember" }
        ]
      },
      {
        "type": "Section",
        "content": [
          { "type": "Button", "id": "submit", "label": "Sign in", "style": "borderedProminent", "action": "js: submit()", "disabled": "${!canSubmit()}",
            "frame": { "maxWidth": "infinity" } },
          { "type": "Text", "text": "$status", "font": "footnote", "foregroundColor": "secondary", "hidden": "${state.status === ''}" }
        ]
      }
    ]
  }
}
